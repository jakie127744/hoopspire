# Cloudflare static-asset headers. The same policy vercel.json states for
# Vercel, so the two hosts do not disagree about what is stale.

# The service worker decides when every other cached thing expires, so it
# must never itself be served from cache.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Snapshots carry their own fetchedAt, so a slightly old copy stays honest.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Content-hashed filenames: a change ships a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
