# Cloudflare static-asset headers. The same policy vercel.json states for
# Vercel, so the two hosts do not disagree about what is stale.

# Google re-reads ads.txt every few days and drops the authorisation if a read
# comes back wrong. Content-Type is explicit because a plain-text file served
# as anything else is not parsed, and the cache is short so a bad copy cannot
# sit in front of a good file for a week.
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# The service worker decides when every other cached thing expires, so it
# must never itself be served from cache.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Snapshots carry their own fetchedAt, so a slightly old copy stays honest.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Content-hashed filenames: a change ships a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
